# ============================================
# Kindness & Care - Environment Variables
# ============================================
# Copy to .env for local reference. Never commit .env.
# On Vercel: Project → Settings → Environment Variables
# (Vercel injects these into api/send-email.js — no Express needed.)

# Email da empresa que recebe os formulários
ADMIN_EMAIL=geral@kindnesscare.pt

# Domínio do site (CORS on the API function)
CORS_ORIGIN=https://www.kindnesscare.pt

# Resend (https://resend.com) — required for forms
# Create an API key in the Resend dashboard (API Keys).
RESEND_API_KEY=re_xxxxxxxx

# From address. Until your domain is verified, use Resend’s test sender:
#   Kindness & Care <onboarding@resend.dev>
# After verifying kindnesscare.pt in Resend → Domains, use e.g.:
#   Kindness & Care <geral@kindnesscare.pt>
RESEND_FROM_EMAIL=Kindness & Care <onboarding@resend.dev>

# Google Analytics 4 Measurement ID (must start with REACT_APP_ for Create React App)
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXX
