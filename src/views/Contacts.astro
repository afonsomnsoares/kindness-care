---
import Layout from '../layouts/Layout.astro';
import './Contacts.css';
import ContactForm from '../components/forms/ContactForm.jsx';
import routes from '../i18n/routes';
import { getT, pickMessages } from '../i18n/i18n';

const { lang } = Astro.props;
const t = getT(lang);

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": t('meta.contacts.title'),
  "description": t('meta.contacts.description'),
  "organization": {
    "@type": "LocalBusiness",
    "name": "Kindness & Care",
    "telephone": "+351968844420",
    "email": "geral@kindnesscare.pt"
  }
};
---

<Layout lang={lang} page="contacts" schema={contactSchema}>
  <div class="contacts-page">
    {/* Hero Section */}
    <section class="contacts-hero-section">
      <div class="contacts-hero-background">
        <div class="contacts-hero-overlay"></div>
      </div>

      <div class="contacts-hero-content">
        <div class="contacts-hero-text">
          <h1 class="contacts-hero-title">{t('contacts.hero.title')}</h1>
          <p class="contacts-hero-subtitle">{t('contacts.hero.subtitle')}</p>
        </div>
      </div>
    </section>

    {/* Conteúdo Principal */}
    <section class="contacts-content-section">
      <div class="container-xxl py-5">
        <div class="container">
          <div class="contacts-grid">

            {/* Informações de Contacto */}
            <div class="contact-info">
              <h2 class="contact-info-title">{t('contacts.info.title')}</h2>
              <p class="contact-info-description">{t('contacts.info.description')}</p>

              <div class="contact-methods">
                <div class="contact-method">
                  <div class="contact-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M22 16.92V19.92C22 20.52 21.53 21 20.94 21C10.47 21 2 12.53 2 3.06C2 2.47 2.48 2 3.08 2H6.08C6.67 2 7.15 2.48 7.15 3.08C7.15 4.03 7.3 4.96 7.59 5.84C7.71 6.21 7.62 6.62 7.35 6.9L5.45 8.8C7.06 12.13 9.87 14.94 13.2 16.55L15.1 14.65C15.38 14.37 15.79 14.28 16.16 14.41C17.04 14.7 17.97 14.85 18.92 14.85C19.52 14.85 20 15.33 20 15.92Z" stroke="#094352" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div class="contact-details">
                    <h3>{t('contacts.info.phone')}</h3>
                    <p><a href="tel:+351968844420">+351 968 844 420</a></p>
                    <p><a href="tel:+351933929761">+351 933 929 761</a></p>
                  </div>
                </div>

                <div class="contact-method">
                  <div class="contact-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z" stroke="#094352" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M22 6L12 13L2 6" stroke="#094352" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div class="contact-details">
                    <h3>{t('contacts.info.email')}</h3>
                    <p><a href="mailto:geral@kindnesscare.pt">geral@kindnesscare.pt</a></p>
                  </div>
                </div>

                <div class="contact-method">
                  <div class="contact-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 7.61305 3.94821 5.32387 5.63604 3.63604C7.32387 1.94821 9.61305 1 12 1C14.3869 1 16.6761 1.94821 18.364 3.63604C20.0518 5.32387 21 7.61305 21 10Z" stroke="#094352" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M12 13C13.6569 13 15 11.6569 15 10C15 8.34315 13.6569 7 12 7C10.3431 7 9 8.34315 9 10C9 11.6569 10.3431 13 12 13Z" stroke="#094352" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <div class="contact-details">
                    <h3>{t('contacts.info.location')}</h3>
                    <p>Braga | Guimarães | Viana do Castelo</p>
                  </div>
                </div>
              </div>
            </div>

            {/* Formulário de Contacto (componente interativo) */}
            <div class="contact-form-container">
              <h2 class="form-title">{t('contacts.form.title')}</h2>
              <ContactForm
                client:load
                messages={pickMessages(lang, ['contacts.form', 'forms', 'common'])}
                privacyPath={routes[lang].privacy}
              />
            </div>

          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
